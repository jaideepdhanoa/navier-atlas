  "copy": {
    "hero_headline": "The Bay is the fastest lane your team isn't using.",
    "hero_sub": "A commuter water network for Bay Area employers \u2014 electric hydrofoil vessels, terminal-to-terminal, faster than the bridge at rush hour.",
    "stripe_lesson": "In 2024 we ran the first employer water commute on the Bay \u2014 daily service for Stripe employees, North Bay to Oyster Point. The ride delivered: smooth, quiet, four feet above the chop, a desk on the water. One structural lesson, stated plainly: we flew an eight-seat executive vessel on a mass-commute job. Commuter-line economics need our twenty-seat vessel, built for exactly this. The ride worked. The vessel class is what we fixed.",
    "loi_cta": "We are sequencing the first commuter lines now. A letter of intent is non-binding \u2014 it costs nothing and commits nothing. It tells us which line to light up first and how many seats employers want on day one. Option A: reserve seats for your team on a line. Option B: anchor a line \u2014 underwrite the vessel, brand the service, shape the service window.",
    "price_anchor": "roughly a parking space \u2014 often less",
    "footer_note": "Letters of intent are non-binding.",
    "problem_chips": [
      {
        "value": "75\u201390 min",
        "label": "Typical Marin \u2192 Peninsula rush-hour drive"
      },
      {
        "value": "2\u00d7",
        "label": "Water is about twice conventional ferry speed"
      },
      {
        "value": "4 ft",
        "label": "Foiling above chop \u2014 smooth enough to work"
      }
    ],
    "launch_trigger": "A line launches when about 60\u201380 seats are committed \u2014 enough for a real commuter service, not a thousand-seat fantasy."
  },
