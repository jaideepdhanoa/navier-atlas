{
  "_internal": {
    "contract": "site",
    "version": "v3",
    "notes": "Public watch reel. No password. Underscore-prefixed fields are never rendered."
  },
  "title": "Navier",
  "route": "/story",
  "noindex": true,
  "robots_meta": "noindex,nofollow",
  "gate": {
    "enabled": false
  },
  "og": {
    "title": "Navier",
    "description": "Watch the films. Read the coverage."
  },
  "nav": {
    "anchors": [
      {"id": "hero", "label": "Watch"},
      {"id": "ride", "label": "Ride"},
      {"id": "films", "label": "Films"},
      {"id": "field", "label": "Field"},
      {"id": "press", "label": "Press"},
      {"id": "talk", "label": "Contact"}
    ]
  },
  "contracts": ["story.json"],
  "analytics": {
    "provider": "vercel",
    "events": [
      "section_view",
      "video_play",
      "video_complete",
      "outbound_click",
      "cta_click"
    ],
    "utm_passthrough": true
  }
}
