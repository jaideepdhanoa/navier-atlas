    {
      "label": "act_2_network_rollout",
      "requests": [
        {
          "deleteText": {
            "objectId": "p8_i3",
            "textRange": {
              "type": "ALL"
            }
          }
        },
        {
          "insertText": {
            "objectId": "p8_i3",
            "insertionIndex": 0,
            "text": "THE PASSENGER EXPERIENCE\nSmooth. Quiet. No fumes. Very little wake."
          }
        },
        {
          "deleteText": {
            "objectId": "p8_i5",
            "textRange": {
              "type": "ALL"
            }
          }
        },
        {
          "insertText": {
            "objectId": "p8_i5",
            "insertionIndex": 0,
            "text": "A CALMER RIDE\nActive flight control responds to chop while the hull travels above much of the wave action."
          }
        },
        {
          "deleteText": {
            "objectId": "p8_i7",
            "textRange": {
              "type": "ALL"
            }
          }
        },
        {
          "insertText": {
            "objectId": "p8_i7",
            "insertionIndex": 0,
            "text": "A BETTER CABIN\nQuiet electric propulsion, no exhaust fumes and wide views make the trip comfortable and conversational."
          }
        },
        {
          "deleteText": {
            "objectId": "p8_i9",
            "textRange": {
              "type": "ALL"
            }
          }
        },
        {
          "insertText": {
            "objectId": "p8_i9",
            "insertionIndex": 0,
            "text": "PUBLIC TRANSIT BY DESIGN\nAccessibility, boarding, bikes, luggage, fare integration and public-service layout must be designed and validated with WETA."
          }
        },
        {
          "deleteText": {
            "objectId": "weta_src_06",
            "textRange": {
              "type": "ALL"
            }
          }
        },
        {
          "insertText": {
            "objectId": "weta_src_06",
            "insertionIndex": 0,
            "text": "Sources: Navier N30 platform \u00b7 SF Bay Ferry passenger and accessibility standards"
          }
        },
        {
          "replaceImage": {
            "imageObjectId": "p8_i2",
            "url": "https://raw.githubusercontent.com/jaideepdhanoa/navier-atlas/c2359e196ed5d569006c4a8383973b23f6f257cd/deck-studio/assets/weta/genai/weta-n30-passenger-experience-v2.png"
          }
        },
        {
          "deleteText": {
            "objectId": "p9_i3",
            "textRange": {
              "type": "ALL"
            }
          }
        },
        {
          "insertText": {
            "objectId": "p9_i3",
            "insertionIndex": 0,
            "text": "A PLATFORM, NOT A ONE-BOAT ANSWER"
          }
        },
        {
          "deleteText": {
            "objectId": "p9_i5",
            "textRange": {
              "type": "ALL"
            }
          }
        },
        {
          "insertText": {
            "objectId": "p9_i5",
            "insertionIndex": 0,
            "text": "The N30 is the starting point: a current vessel for validating the electric hydrofoil stack, Bay operating data and passenger experience. The service layer can grow only when evidence supports it."
          }
        },
        {
          "deleteText": {
            "objectId": "g3f266457366_0_8",
            "textRange": {
              "type": "ALL"
            }
          }
        },
        {
          "insertText": {
            "objectId": "g3f266457366_0_8",
            "insertionIndex": 0,
            "text": "NEAR TERM\nMultiple smaller vessels can add frequency and flexibility in measured increments where demand and public-service requirements support them."
          }
        },
        {
          "deleteText": {
            "objectId": "g3f266457366_0_10",
            "textRange": {
              "type": "ALL"
            }
          }
        },
        {
          "insertText": {
            "objectId": "g3f266457366_0_10",
            "insertionIndex": 0,
            "text": "OVER TIME\nLarger-capacity foiling platforms and autonomy can deepen the economics after certification, service design and operating proof. Neither is required to begin."
          }
        },
        {
          "deleteText": {
            "objectId": "weta_src_07",
            "textRange": {
              "type": "ALL"
            }
          }
        },
        {
          "insertText": {
            "objectId": "weta_src_07",
            "insertionIndex": 0,
            "text": "Sources: Navier N30 platform \u00b7 Navier company and autonomy materials"
          }
        },
        {
          "replaceImage": {
            "imageObjectId": "p9_i2",
            "url": "https://raw.githubusercontent.com/jaideepdhanoa/navier-atlas/c2359e196ed5d569006c4a8383973b23f6f257cd/deck-studio/assets/weta/genai/weta-n30-alameda-hero-v2.png"
          }
        },
        {
          "deleteText": {
            "objectId": "p11_i3",
            "textRange": {
              "type": "ALL"
            }
          }
        },
        {
          "insertText": {
            "objectId": "p11_i3",
            "insertionIndex": 0,
            "text": "ONE NETWORK\nThree practical uses"
          }
        },
        {
          "deleteText": {
            "objectId": "p11_i4",
            "textRange": {
              "type": "ALL"
            }
          }
        },
        {
          "insertText": {
            "objectId": "p11_i4",
            "insertionIndex": 0,
            "text": "STRENGTHEN EXISTING SERVICE\nAdd targeted frequency, shoulder-period trips or a smaller capacity increment where WETA identifies a real rider need."
          }
        },
        {
          "deleteText": {
            "objectId": "p11_i6",
            "textRange": {
              "type": "ALL"
            }
          }
        },
        {
          "insertText": {
            "objectId": "p11_i6",
            "insertionIndex": 0,
            "text": "LAUNCH PLANNED EXPANSION\nGive an emerging market a practical electric starting point while WETA learns demand and operating needs."
          }
        },
        {
          "deleteText": {
            "objectId": "p11_i8",
            "textRange": {
              "type": "ALL"
            }
          }
        },
        {
          "insertText": {
            "objectId": "p11_i8",
            "insertionIndex": 0,
            "text": "OPEN OVERLOOKED LINKS\nTest a waterfront-to-waterfront trip where road travel is indirect and large-ferry demand is not yet proven."
          }
        },
        {
          "deleteText": {
            "objectId": "p11_i10",
            "textRange": {
              "type": "ALL"
            }
          }
        },
        {
          "insertText": {
            "objectId": "p11_i10",
            "insertionIndex": 0,
            "text": "START SMALL\nBegin with one bounded public problem and a clear operating hypothesis."
          }
        },
        {
          "deleteText": {
            "objectId": "p11_i12",
            "textRange": {
              "type": "ALL"
            }
          }
        },
        {
          "insertText": {
            "objectId": "p11_i12",
            "insertionIndex": 0,
            "text": "GROW WITH DATA\nAdd frequency, vessels or capacity only after real Bay performance is known."
          }
        },
        {
          "deleteText": {
            "objectId": "p11_i14",
            "textRange": {
              "type": "ALL"
            }
          }
        },
        {
          "insertText": {
            "objectId": "p11_i14",
            "insertionIndex": 0,
            "text": "WETA DECIDES\nWETA retains network, safety, procurement and public-service authority."
          }
        },
