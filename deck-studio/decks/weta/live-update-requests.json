            }
          }
        },
        {
          "insertText": {
            "objectId": "weta_src_05",
            "insertionIndex": 0,
            "text": "Sources: Navier N30 platform \u00b7 Navier company and autonomy materials"
          }
        },
        {
          "replaceImage": {
            "imageObjectId": "p6_i2",
            "url": "https://raw.githubusercontent.com/jaideepdhanoa/navier-atlas/c2359e196ed5d569006c4a8383973b23f6f257cd/deck-studio/assets/weta/genai/weta-n30-foil-efficiency-v2.png"
