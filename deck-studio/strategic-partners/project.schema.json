{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/navier/strategic-partner-project-1.0.0.json",
  "title": "Strategic partner deck project",
  "description": "Partner-neutral, source-led deck content contract. Runtime validation adds audience, privacy, filesystem, and editorial heuristics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "meta", "sources", "claims", "assets", "opportunities", "slides", "policy"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "meta": {"$ref": "#/$defs/meta"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "opportunities": {"type": "array", "items": {"$ref": "#/$defs/opportunity"}},
    "slides": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/slide"}},
    "policy": {"$ref": "#/$defs/policy"}
