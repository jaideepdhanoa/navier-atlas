{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa-receipt.schema.json",
  "type": "object",
  "required": [
    "deck_key",
    "status",
    "checks",
    "generated_at"
  ],
  "properties": {
    "deck_key": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "pass",
        "pass_with_flags",
        "fail"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "warning"
            ]
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "generated_at": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
