{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "image-manifest.schema.json",
  "title": "Deck image manifest (v1 + v2 superset)",
  "description": "Validates v1 placeholder manifests and v2 asset-pack manifests with role contract fields.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "deck_key",
    "policy",
    "images"
  ],
  "properties": {
    "deck_key": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "type": "string"
    },
    "policy": {
      "type": "string",
      "minLength": 1
    },
    "asset_registry": {
      "type": ["string", "null"]
    },
    "role_contract": {
      "type": ["string", "null"]
    },
    "current_spec_refresh": {
      "type": "object",
      "additionalProperties": true
    },
    "wired_at": {
      "type": "string"
    },
    "wired_by": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "image_key",
          "status"
        ],
        "properties": {
          "image_key": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string"
          },
          "asset_ref": {
            "type": ["string", "null"]
          },
          "registry_key": {
            "type": ["string", "null"]
          },
          "asset_path": {
            "type": ["string", "null"]
          },
          "target_slide_index": {
            "type": "integer"
          },
          "target_slide_object_id": {
            "type": ["string", "null"]
          },
          "target_object_id": {
            "type": ["string", "null"]
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "asset_delivery": {
            "type": "object",
            "additionalProperties": true
          },
          "official_source": {
            "type": ["string", "null"]
          },
          "source_type": {
            "type": ["string", "null"]
          },
          "provenance_required": {
            "type": "boolean"
          },
          "background_source": {
            "type": ["string", "null"]
          },
          "vessel_source": {
            "type": ["string", "null"]
          },
          "mask_source": {
            "type": ["string", "null"]
          },
          "prompt_path": {
            "type": ["string", "null"]
          },
          "output_path": {
            "type": ["string", "null"]
          },
          "source_url": {
            "type": ["string", "null"]
          },
          "aspect_ratio": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "legacy_role": {
            "type": "string"
          }
        }
      }
    }
  }
}