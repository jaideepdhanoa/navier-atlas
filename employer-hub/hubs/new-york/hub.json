  "calculator": {
    "profile": "nyc_parking_toll",
    "inputs": {
      "S_committed_seats": {
        "default": 60,
        "label": "Committed seats",
        "note": null
      },
      "D_commute_days_per_month": {
        "default": 16,
        "label": "Commute days / employee / month",
        "note": null
      },
      "P_price_per_seat_month": {
        "default": 750,
        "label": "Price per seat-month ($)",
        "min": 750,
        "max": 900,
        "note": "standard $750 \u00b7 no-ferry-alternative $900"
      },
      "sigma_employer_subsidy_share": {
        "default": 0.8,
        "label": "Employer subsidy share",
        "note": null
      },
      "X_pretax_benefit_cap_month": {
        "default": 340,
        "label": "Pre-tax commuter benefit used / month ($)",
        "note": null
      },
      "V_current_shuttle_cost_seat_month": {
        "default": 0,
        "label": "Current shuttle / vanpool cost per seat-month ($)",
        "note": "Enter your current shuttle or vanpool cost if you run one"
      },
      "K_parking_cost_stall_month": {
        "default": 570,
        "label": "Manhattan parking cost per stall-month ($)",
        "note": null
      },
      "rho_share_displacing_stall": {
        "default": 0.5,
        "label": "Share of riders who displace a parking stall",
        "note": null
      },
      "G_congestion_toll_weekday": {
        "default": 9,
        "label": "Congestion toll / weekday ($)",
        "note": null
      },
      "W_weekdays_per_month": {
        "default": 21,
        "label": "Weekdays / month",
        "note": null
      }
    },
    "formulas": {
      "gross_program_cost": "S*P",
      "employee_pretax_contribution": "S*min(X,(1-sigma)*P)",
      "net_employer_cost": "S*P - S*min(X,(1-sigma)*P)",
      "net_employer_cost_per_rider": "net_employer_cost/S",
      "statusquo_benchmark_per_rider": "K + G*W",
      "parking_offset": "S*rho*K",
      "shuttle_offset": "S*V",
      "net_incremental_after_offsets": "net_employer_cost - parking_offset - shuttle_offset"
    },
