  "calculator": {
    "profile": "bay_productivity",
    "inputs": {
      "seats": {
        "default": 60,
        "label": "Committed seats"
      },
      "days_per_month": {
        "default": 16,
        "label": "Commute days / employee / month"
      },
      "price_seat_month": {
        "default": 1000,
        "min": 800,
        "max": 1200,
        "label": "Price per seat-month ($)"
      },
      "subsidy_share": {
        "default": 0.8,
        "label": "Employer subsidy share"
      },
      "pretax_benefit": {
        "default": 325,
        "label": "Pre-tax commuter benefit used / month ($)",
        "note": "2026 qualified transportation fringe est. \u2014 verify current IRS limit"
      },
      "shuttle_cost": {
        "default": 550,
        "label": "Current shuttle / vanpool cost per seat-month ($)"
      },
      "parking_cost": {
        "default": 350,
        "label": "Parking cost per stall-month ($)"
      },
      "parking_share": {
        "default": 0.5,
        "label": "Share of riders who displace a parking stall"
      },
      "car_min": {
        "default": 75,
        "label": "One-way car commute (min)"
      },
      "water_min": {
        "default": 30,
        "label": "One-way water commute (min)"
      },
      "car_miles": {
        "default": 20,
        "label": "One-way car distance (mi)"
      },
      "co2_kg_per_mile": {
        "default": 0.35,
        "label": "CO2 per car-mile (kg)"
      },
      "hour_cost": {
        "default": 90,
        "label": "Fully-loaded cost of an employee hour ($)"
      }
    },
    "formulas": {
      "gross": "seats*price_seat_month",
      "employee_contribution": "seats*min(pretax_benefit,(1-subsidy_share)*price_seat_month)",
      "net_employer": "gross-employee_contribution",
      "shuttle_offset": "seats*shuttle_cost",
      "parking_offset": "seats*parking_share*parking_cost",
      "net_incremental": "net_employer-shuttle_offset-parking_offset",
      "hours_returned": "seats*days_per_month*2*(car_min-water_min)/60",
      "productivity_value": "hours_returned*hour_cost",
      "co2_tonnes": "seats*days_per_month*2*car_miles*co2_kg_per_mile/1000",
      "net_cost_per_hour": "hours_returned==0 ? 0 : net_incremental/hours_returned"
    },
    "worked_example_at_defaults": {
      "net_incremental_month": 4500,
      "per_rider_month": 75
    },
    "caveat": "Indicative planning tool, not a quote.",
    "field_order": [
      "seats",
      "days_per_month",
      "price_seat_month",
      "subsidy_share",
      "pretax_benefit",
      "shuttle_cost",
      "parking_cost",
      "parking_share",
      "car_min",
      "water_min",
      "car_miles",
      "co2_kg_per_mile",
      "hour_cost"
    ],
    "headline": {
      "kicker": "Net incremental employer cost",
      "default_net": "$4,500",
      "default_per": "$75 per rider / month"
    },
    "worked_assert": {
      "net_incremental": 4500,
      "per_rider": 75
    }
  },
