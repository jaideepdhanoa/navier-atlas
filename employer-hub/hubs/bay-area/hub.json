  "copy": {
    "hero_headline": "The Bay is the fastest lane your team isn't using.",
    "hero_sub": "A commuter water network for Bay Area employers \u2014 electric hydrofoil vessels, terminal-to-terminal, faster than the bridge at rush hour.",
    "stripe_lesson": "In 2024 we ran the first employer water commute on the Bay \u2014 daily service for Stripe employees, North Bay to Oyster Point. The ride delivered: smooth, quiet, four feet above the chop, a desk on the water. One structural lesson, stated plainly: we flew an eight-seat executive vessel on a mass-commute job. Commuter-line economics need our twenty-seat vessel, built for exactly this. The ride worked. The vessel class is what we fixed.",
    "loi_cta": "We are sequencing the first commuter lines now. A letter of intent is non-binding \u2014 it costs nothing and commits nothing. It tells us which line to light up first and how many seats employers want on day one. Option A: reserve seats for your team on a line. Option B: anchor a line \u2014 underwrite the vessel, brand the service, shape the service window.",
    "price_anchor": "roughly a parking space \u2014 often less",
    "footer_note": "Letters of intent are non-binding.",
    "problem_chips": [
      {
        "value": "75\u201390 min",
        "label": "Typical Marin \u2192 Peninsula rush-hour drive"
      },
      {
        "value": "2\u00d7",
        "label": "Water is about twice conventional ferry speed"
      },
      {
        "value": "4 ft",
        "label": "Foiling above chop \u2014 smooth enough to work"
      }
    ],
    "launch_trigger": "A line launches when about 60\u201380 seats are committed \u2014 enough for a real commuter service, not a thousand-seat fantasy.",
    "problem_title": "The bridge is the bottleneck. The Bay is the spare lane.",
    "problem_lead": "Your people already live and work on water-adjacent campuses. Rush-hour road time is the tax. Water cuts that tax \u2014 quietly, on a service window you help form with seat interest.",
    "proof_title": "We already proved the ride.",
    "proof_lead": "The Stripe pilot is public record. We keep the lesson as plain as the ride was smooth.",
    "proof_worked_title": "What worked",
    "proof_worked_body": "Smooth, quiet, four feet above the chop \u2014 a real desk on the water for a daily employer commute.",
    "proof_fixed_title": "What we fixed",
    "proof_fixed_body": "Commuter service needs the twenty-seat vessel, not an eight-seat executive shuttle on a mass-commute job.",
    "proof_ask_title": "What we ask now",
    "proof_ask_body": "Non-binding seat interest so we light the right line first \u2014 not a thousand-seat fantasy trigger.",
    "network_title": "The network",
    "network_lead": "Six real terminals already on the Atlas map. Three employer lines, drawn on the water. Tap a stop to see who it serves \u2014 and seed the calculator and letter of intent.",
    "map_detail_empty": "Select a line or stop to see water vs drive times and who each terminal serves.",
    "calc_title": "What it costs your team",
    "calc_lead_html": "Planning defaults reproduce a worked example of <strong>$4,500/mo</strong> net incremental \u2014 about <strong>$75 per rider</strong>. Change the inputs; the math stays the same.",
    "loi_title": "Letter of intent",
    "hero_note": "Non-binding letter of intent \u00b7 no commitment \u00b7 helps us sequence which line launches first",
    "hero_cta_network": "See the network near me",
    "hero_cta_calc": "Estimate cost for my team",
    "nav_cta": "Reserve interest"
  },
