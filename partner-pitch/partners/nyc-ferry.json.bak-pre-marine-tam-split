  "differentiation": {
    "why_navier": "A software-defined, autonomy-ready foiling platform that is faster, longer-range and near-wakeless — opening new long routes the diesel cats can't serve, ending East River wake complaints, and decarbonizing the network with only a berth pedestal."
  },
  "proof_points": [
    {
      "claim": "NYC Ferry is the busiest US urban ferry network.",
      "evidence": "~32M+ annual trips across the East River, Hudson and harbor, with the city actively expanding service.",
