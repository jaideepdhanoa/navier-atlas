    {
      "claim": "Subway and road capacity is maxed.",
      "evidence": "With the subway and bridges at capacity, the surrounding water is New York's most underused right-of-way.",
      "source": "MTA / NYCDOT, 2026"
    }
  ],
  "objections": [
    {
      "concern": "NYC Ferry is heavily subsidized already.",
      "response": "Foiling improves the economics — faster turns, more trips per vessel, lower fuel — and opens revenue routes (long-range, regional) the diesel cats can't serve."
    },
    {
      "concern": "The harbor has heavy commercial traffic and ice risk.",
      "response": "Software-defined routing manages traffic separation; foils ride above chop, and operations flex seasonally as the existing fleet already does."
    },
    {
      "concern": "Procurement runs through the city/EDC.",
      "response": "We start with a demonstration on a flagship route (Rockaway long-haul or an East River wake-sensitive corridor) to prove the model before any fleet decision."
    },
    {
      "concern": "Accessibility and capacity standards are strict.",
      "response": "The platform meets ADA and Coast Guard passenger standards; capacity is matched to route demand, supplementing rather than replacing high-capacity cats."
    }
  ],
